# Credenciais usadas pelo cmc-boot.sh para realm leave/join quando o hostname muda.
# Arquivo lido pelo systemd via EnvironmentFile (cmc-boot.service).
# Mantido com permissao 0600 (somente root) para nao expor a senha do AD.
AD_JOIN_USER={{ estacao_ad_join_user }}
AD_JOIN_PASS={{ estacao_ad_join_pass }}
