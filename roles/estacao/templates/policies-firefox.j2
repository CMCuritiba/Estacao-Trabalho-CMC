{
  "policies": {
    "DownloadDirectory": "${home}/Downloads",
    "DisplayBookmarksToolbar": true,
    "DisableAppUpdate": true,
    "ManagedBookmarks": [
      {
        "toplevel_name": "Favoritos Gerenciados da CMC"
      },
    {% for bookmark in estacao_bookmarks | sort(attribute='name') %}
      {
        "name": "{{ bookmark.name }}",
      {% if bookmark.url is defined %}
        "url": "{{ bookmark.url }}"
      {% else %}
        "children": [
        {% for child in bookmark.children | sort(attribute='name') %}
          {
            "name": "{{ child.name }}",
            "url": "{{ child.url }}"
          }{{loop.last | ternary('', ',')}}
        {% endfor %}
        ]
      {% endif %}
      }{{loop.last | ternary('', ',')}}
    {% endfor %}
    {% if estacao_firefox_addons is defined and estacao_firefox_addons | length > 0 %}
    ],
    "ExtensionSettings": {
      {% for addon in estacao_firefox_addons %}
      "{{ addon.name }}": {
        "installation_mode": "force_installed",
        "install_url": "{{ addon.url }}",
        "updates_disabled": false
      }{{loop.last | ternary('', ',')}}
    },
      {% endfor %}
    {% else %}
    ],
    {% endif %}
    "ExtensionUpdate": true
  }
}
